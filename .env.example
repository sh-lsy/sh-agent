# ==============================================================================
# sh-agent 环境变量配置模板
# 复制本文件为 .env 并填入你的 API Key 即可：
# Windows PowerShell: Copy-Item .env.example .env
# Bash: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 默认激活的模型配置（默认推荐 DeepSeek 或 硅基流动，性价比极高，完全兼容 OpenAI 协议）
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com/v1
DEFAULT_MODEL=deepseek-chat

# 模型角色路由（fast 负责高频工具调用与日常循环，reasoning 负责长链思考与反思）
MODEL_FAST=deepseek-chat
MODEL_REASONING=deepseek-reasoner

# ------------------------------------------------------------------------------
# 常用国内 / 国际大模型厂商接入参考配置（取消注释并切换到上方对应变量）
# ------------------------------------------------------------------------------

# 1. DeepSeek 官方
# 注册地址: https://platform.deepseek.com/
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_API_KEY=sk-xxxx
# DEFAULT_MODEL=deepseek-chat          # 通用对话 (DeepSeek-V3)
# DEFAULT_MODEL=deepseek-reasoner      # 推理思考 (DeepSeek-R1)

# 2. 硅基流动 (SiliconFlow) - 支持海量开源模型，新用户赠送额度
# 注册地址: https://cloud.siliconflow.cn/
# OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# OPENAI_API_KEY=sk-xxxx
# DEFAULT_MODEL=deepseek-ai/DeepSeek-V3
# DEFAULT_MODEL=deepseek-ai/DeepSeek-R1
# DEFAULT_MODEL=Qwen/Qwen2.5-72B-Instruct

# 3. 阿里云百炼 (通义千问 Qwen)
# 注册地址: https://bailian.console.aliyun.com/
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_API_KEY=sk-xxxx
# DEFAULT_MODEL=qwen-plus
# DEFAULT_MODEL=qwen-max

# 4. 智谱 AI (GLM)
# 注册地址: https://bigmodel.cn/
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# OPENAI_API_KEY=your_zhipu_api_key
# DEFAULT_MODEL=glm-4-flash            # 免费极速模型，极适合练习

# 5. 月之暗面 (Moonshot / Kimi)
# 注册地址: https://platform.moonshot.cn/
# OPENAI_BASE_URL=https://api.moonshot.cn/v1
# OPENAI_API_KEY=sk-xxxx
# DEFAULT_MODEL=moonshot-v1-8k

# 6. 本地部署 (Ollama)
# 本地运行: ollama run qwen2.5:7b
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# DEFAULT_MODEL=qwen2.5:7b

# 7. OpenAI 官方
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-xxxx
# DEFAULT_MODEL=gpt-4o-mini
