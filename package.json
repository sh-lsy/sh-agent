{
  "name": "sh-agent",
  "version": "1.0.0",
  "description": "前端开发者的 Agent 系统学习之旅 —— 基于 Datawhale Hello-Agents 教程的 TypeScript 实践与工程重构",
  "type": "module",
  "main": "learning/index.ts",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "docs:ref": "serve references/hello-agents/docs -l 3000 --cors",
    "docs:ref:py": "python -m http.server 3000 -d references/hello-agents/docs",
    "docs:learn": "vitepress dev docs --port 5173",
    "docs:build": "vitepress build docs",
    "docs:all": "concurrently -n \"REF,LEARN\" -c \"cyan,green\" \"pnpm run docs:ref\" \"pnpm run docs:learn\"",
    "docs": "pnpm run docs:learn",
    "check:secrets": "node scripts/check-secrets.mjs",
    "dev:01": "tsx learning/01-fundamentals/src/index.ts",
    "dev:02": "tsx learning/02-paradigms/src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sh-lsy/sh-agent.git"
  },
  "keywords": [
    "ai-agent",
    "typescript",
    "hello-agents",
    "react-agent",
    "llm",
    "vue3-developer",
    "vitepress"
  ],
  "author": "sh-lsy",
  "license": "CC-BY-NC-SA-4.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^16.4.7",
    "js-tiktoken": "^1.0.21",
    "openai": "^4.86.1",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.7",
    "serve": "^14.2.7",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.7",
    "vue": "^3.5.45"
  }
}
